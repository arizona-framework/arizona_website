{minimum_otp_vsn, "29"}.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    {arizona, {git, "https://github.com/arizona-framework/arizona.git", {branch, "main"}}}
]}.

%% The counter the home page shows is compiled with the site, so the sample
%% on the page is code that builds.
{extra_src_dirs, ["examples"]}.

{erlfmt, [
    write,
    {files, ["rebar.config", "src/*.app.src", "src/**/*.erl", "examples/**/*.erl"]}
]}.

{project_plugins, [{erlfmt, "1.8.0"}]}.
